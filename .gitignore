# ============================================================
# .gitignore — Pakistan Digital Health Platform
# ============================================================

# ----- Secrets & Environment --------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/

# ----- Rust -------------------------------------------------
backend/target/
backend/**/*.rs.bk
backend/Cargo.lock.bak
**/*.orig

# ----- Node / Frontend --------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
*.tsbuildinfo

# ----- Docker -----------------------------------------------
.docker/
docker-compose.override.yml

# ----- PostgreSQL -------------------------------------------
pgdata/
*.sql.bak

# ----- MinIO ------------------------------------------------
minio_data/

# ----- OS ---------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~

# ----- IDE --------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo

# ----- Logs -------------------------------------------------
logs/
*.log
*.log.*

# ----- Coverage / Testing -----------------------------------
lcov.info
coverage/
tarpaulin-report.html

# ----- Misc -------------------------------------------------
tmp/
temp/
.cache/
