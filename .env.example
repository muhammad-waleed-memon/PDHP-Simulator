# ============================================================
# Environment Variables — Pakistan Digital Health Platform
# ============================================================
# Copy this file to .env and fill in appropriate values.
# NEVER commit the .env file to version control.
# All values here are SAFE DEFAULTS for local development only.
# ============================================================

# --- Application -----------------------------------------------
APP_ENV=development
APP_NAME="Pakistan Digital Health Platform"
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Database --------------------------------------------------
DATABASE_URL=postgres://dhp_user:dhp_password@postgres:5432/digital_health_platform
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=2
DATABASE_CONNECT_TIMEOUT_SECONDS=30

# --- JWT Authentication ----------------------------------------
# MUST be a long random string in production (min 64 chars)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_IN_PRODUCTION_MIN_64_CHARACTERS
JWT_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# --- Argon2 Password Hashing -----------------------------------
# Do not change these unless you understand the implications
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# --- CORS ------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://localhost

# --- Rate Limiting ---------------------------------------------
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---------------------------------------------------
RUST_LOG=info,backend=debug,sqlx=warn,tower_http=debug

# --- MinIO (Prototype Object Storage) --------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=CHANGE_THIS_MINIO_SECRET_IN_PRODUCTION
MINIO_BUCKET_LAB_REPORTS=lab-reports
MINIO_BUCKET_DOCUMENTS=documents
MINIO_USE_SSL=false

# --- PostgreSQL (used by docker compose) -----------------------
POSTGRES_DB=digital_health_platform
POSTGRES_USER=dhp_user
POSTGRES_PASSWORD=dhp_password

# --- Nginx -----------------------------------------------------
NGINX_HTTP_PORT=80

# --- Frontend --------------------------------------------------
VITE_API_BASE_URL=http://localhost/api/v1
VITE_FHIR_BASE_URL=http://localhost/fhir

# --- Break-Glass Access ----------------------------------------
BREAK_GLASS_MAX_DURATION_HOURS=4

# --- Seed Data -------------------------------------------------
SEED_DEMO_DATA=true
DEMO_PATIENT_PASSWORD=PatientDemo123!
DEMO_DOCTOR_PASSWORD=DoctorDemo123!
DEMO_LAB_PASSWORD=LabUserDemo123!
DEMO_FACILITY_ADMIN_PASSWORD=FacilityAdminDemo123!
DEMO_SYSTEM_ADMIN_PASSWORD=SysAdminDemo123!
